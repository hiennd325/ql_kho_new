{
  "info": {
    "name": "QL Kho - Test Đăng Nhập",
    "description": "Đầy đủ các trường hợp kiểm thử cho chức năng đăng nhập (TC1 - TC11)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:3000/api/v1"
    },
    {
      "key": "auth_token",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "TC1 & TC8: Đăng nhập thành công (Hợp lệ)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "var jsonData = pm.response.json();",
              "if (jsonData.token) { pm.collectionVariables.set(\"auth_token\", jsonData.token); }"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"admin123\"\n}"
        },
        "url": "{{base_url}}/auth/login"
      }
    },
    {
      "name": "TC2: Tên đăng nhập để trống",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"\",\n  \"password\": \"admin12345\"\n}"
        },
        "url": "{{base_url}}/auth/login"
      }
    },
    {
      "name": "TC3: Mật khẩu < 8 ký tự",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"AdminHung\",\n  \"password\": \"12345\"\n}"
        },
        "url": "{{base_url}}/auth/login"
      }
    },
    {
      "name": "TC4: Mật khẩu không chứa chữ và số (Chỉ ký tự đặc biệt)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"AdminHung\",\n  \"password\": \"!@#$%^&*()\"\n}"
        },
        "url": "{{base_url}}/auth/login"
      }
    },
    {
      "name": "TC5: Mật khẩu chỉ chứa chữ",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"AdminHung\",\n  \"password\": \"Password\"\n}"
        },
        "url": "{{base_url}}/auth/login"
      }
    },
    {
      "name": "TC6: Mật khẩu chỉ chứa số",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"AdminHung\",\n  \"password\": \"123456789\"\n}"
        },
        "url": "{{base_url}}/auth/login"
      }
    },
    {
      "name": "TC7: Mật khẩu để trống",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"AdminHung\",\n  \"password\": \"\"\n}"
        },
        "url": "{{base_url}}/auth/login"
      }
    },
    {
      "name": "TC9: Sai mật khẩu",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"admin143\"\n}"
        },
        "url": "{{base_url}}/auth/login"
      }
    },
    {
      "name": "TC10: Tên đăng nhập không đúng (Không tồn tại)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"Thanh@13\",\n  \"password\": \"admin12345\"\n}"
        },
        "url": "{{base_url}}/auth/login"
      }
    },
    {
      "name": "TC11: Thông tin đăng nhập sai (Cả 2 đều sai)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"HienUser\",\n  \"password\": \"124356\"\n}"
        },
        "url": "{{base_url}}/auth/login"
      }
    }
  ]
}