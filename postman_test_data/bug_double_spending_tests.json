							"});",
							"",
							"var jsonData = pm.response.json();",
							"pm.environment.set(\"transfer_id\", jsonData.transfer.id);",
							"console.log(\"Đã tạo phiếu chuyển kho ID: \" + jsonData.transfer.id);"
						],
						"type": "text/javascript"
					}
				}
