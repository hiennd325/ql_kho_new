					"raw": "{\n    \"from_warehouse_id\": \"WH001\",\n    \"to_warehouse_id\": \"WH002\",\n    \"items\": [\n        {\n            \"product_id\": \"SP001\",\n            \"quantity\": 10\n        }\n    ],\n    \"notes\": \"Test kịch bản Double Spending\"\n}"
				},
				"url": {
					"raw": "{{base_url}}/transfers",
