						"status"
					]
				}
			},
			"response": []
		},
		{
			"name": "4. Replay Attack (Lần 2 - Test BUG)",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Kỳ vọng hệ thống CHẶN LẠI (Status code is 400 hoặc 500)\", function () {",
							"    pm.expect(pm.response.code).to.be.oneOf([400, 403, 500]);",
							"});",
							"",
							"pm.test(\"Nếu Status là 200 => HỆ THỐNG ĐANG BỊ LỖI DOUBLE-SPENDING\", function() {",
							"    pm.expect(pm.response.code).to.not.equal(200);",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "PUT",
				"header": [
