{
  "info": {
    "name": "QL Kho - Test Kho Hàng",
    "description": "Đầy đủ các trường hợp kiểm thử cho chức năng thêm kho hàng mới (TC1 - TC10)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:3000/api/v1"
    },
    {
      "key": "auth_token",
      "value": ""
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{auth_token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Đăng nhập lấy Token (Chuẩn bị)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "var jsonData = pm.response.json();",
              "if (jsonData.token) { pm.collectionVariables.set(\"auth_token\", jsonData.token); }"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "auth": {
          "type": "noauth"
        },
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"admin123\"\n}"
        },
        "url": "{{base_url}}/auth/login"
      }
    },
    {
      "name": "TC1: Thêm kho hàng thành công",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 201\", function () { pm.response.to.have.status(201); });",
              "pm.test(\"Contains warehouse custom_id\", function () { pm.expect(pm.response.json().custom_id).to.eql(\"KHO_HN_01\"); });"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"custom_id\": \"KHO_HN_01\",\n  \"name\": \"Kho Hà Nội 1\",\n  \"location\": \"Hà Nội\",\n  \"capacity\": 10000\n}"
        },
        "url": "{{base_url}}/warehouses"
      }
    },
    {
      "name": "TC2 & TC10: Mã kho đã tồn tại",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 400\", function () { pm.response.to.have.status(400); });",
              "pm.test(\"Contains duplicate error message\", function () { pm.expect(pm.response.json().error).to.eql(\"Mã kho đã tồn tại\"); });"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"custom_id\": \"KHO_HN_01\",\n  \"name\": \"Kho Hà Nội Mới\",\n  \"location\": \"Hà Nội\",\n  \"capacity\": 5000\n}"
        },
        "url": "{{base_url}}/warehouses"
      }
    },
    {
      "name": "TC3: Mã kho bị trống",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Assert response for empty customId\", function () { pm.expect(pm.response.code).to.be.oneOf([400, 500]); });"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"custom_id\": \"\",\n  \"name\": \"Kho Hải Phòng\",\n  \"location\": \"Hải Phòng\",\n  \"capacity\": 3000\n}"
        },
        "url": "{{base_url}}/warehouses"
      }
    },
    {
      "name": "TC4 & TC9: Tên kho không được để trống",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 500 (DB Constraint)\", function () { pm.response.to.have.status(500); });",
              "pm.test(\"Contains database constraint error\", function () { pm.expect(pm.response.json().error).to.include(\"NOT NULL constraint failed\"); });"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"custom_id\": \"KHO_HP_01\",\n  \"name\": \"\",\n  \"location\": \"Hải Phòng\",\n  \"capacity\": 3000\n}"
        },
        "url": "{{base_url}}/warehouses"
      }
    },
    {
      "name": "TC5 & TC8: Sức chứa phải lớn hơn 0 (Lỗi)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Assert capacity validation response\", function () { pm.expect(pm.response.code).to.be.oneOf([400, 500]); });"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"custom_id\": \"KHO_HP_02\",\n  \"name\": \"Kho Hải Phòng 2\",\n  \"location\": \"Hải Phòng\",\n  \"capacity\": -50\n}"
        },
        "url": "{{base_url}}/warehouses"
      }
    },
    {
      "name": "TC6: Sức chứa không phải là số hợp lệ",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Assert non-numeric capacity response\", function () { pm.expect(pm.response.code).to.be.oneOf([400, 500]); });"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"custom_id\": \"KHO_HP_03\",\n  \"name\": \"Kho Hải Phòng 3\",\n  \"location\": \"Hải Phòng\",\n  \"capacity\": \"abc\"\n}"
        },
        "url": "{{base_url}}/warehouses"
      }
    },
    {
      "name": "TC7: Thêm kho thành công (Kho Đà Nẵng)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 201\", function () { pm.response.to.have.status(201); });"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"custom_id\": \"KHO_DN\",\n  \"name\": \"Kho Đà Nẵng\",\n  \"location\": \"Đà Nẵng\",\n  \"capacity\": 5000\n}"
        },
        "url": "{{base_url}}/warehouses"
      }
    },
    {
      "name": "Dọn dẹp kho Hà Nội",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Deleted successfully\", function () { pm.expect(pm.response.code).to.be.oneOf([200, 404]); });"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "DELETE",
        "url": "{{base_url}}/warehouses/KHO_HN_01"
      }
    },
    {
      "name": "Dọn dẹp kho Đà Nẵng",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Deleted successfully\", function () { pm.expect(pm.response.code).to.be.oneOf([200, 404]); });"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "DELETE",
        "url": "{{base_url}}/warehouses/KHO_DN"
      }
    }
  ]
}
