{
  "info": {
    "name": "QL Kho - Test Nhập Kho",
    "description": "Đầy đủ các trường hợp kiểm thử cho chức năng nhập kho hàng loạt (TC1 - TC10)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:3000/api/v1"
    },
    {
      "key": "auth_token",
      "value": ""
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{auth_token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Đăng nhập lấy Token (Chuẩn bị)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "var jsonData = pm.response.json();",
              "if (jsonData.token) { pm.collectionVariables.set(\"auth_token\", jsonData.token); }"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "auth": {
          "type": "noauth"
        },
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"admin123\"\n}"
        },
        "url": "{{base_url}}/auth/login"
      }
    },
    {
      "name": "Chuẩn bị Kho bãi và Sản phẩm để Test",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Setup successful\", function () { pm.expect(pm.response.code).to.be.oneOf([201, 200, 400]); });"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"custom_id\": \"KHO_HN_01\",\n  \"name\": \"Kho Hà Nội 1\",\n  \"capacity\": 200\n}"
        },
        "url": "{{base_url}}/warehouses"
      }
    },
    {
      "name": "Chuẩn bị Sản phẩm để Test",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Product setup successful\", function () { pm.expect(pm.response.code).to.be.oneOf([201, 200, 400]); });"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"customId\": \"SP001\",\n  \"name\": \"Sữa tươi TH True Milk\",\n  \"price\": 15000,\n  \"supplierId\": 1\n}"
        },
        "url": "{{base_url}}/products"
      }
    },
    {
      "name": "TC1 & TC7: Nhập kho thành công",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 201\", function () { pm.response.to.have.status(201); });",
              "pm.test(\"Contains success message\", function () { pm.expect(pm.response.json().message).to.eql(\"Bulk import successful\"); });"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"warehouse_id\": \"KHO_HN_01\",\n  \"supplier_id\": \"SUP1\",\n  \"products\": [\n    {\n      \"product_id\": \"SP001\",\n      \"quantity\": 100\n    }\n  ]\n}"
        },
        "url": "{{base_url}}/inventory/import"
      }
    },
    {
      "name": "TC2 & TC10: Kho hàng không tồn tại",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 400\", function () { pm.response.to.have.status(400); });",
              "pm.test(\"Error matches warehouse not found\", function () { pm.expect(pm.response.json().error).to.eql(\"Warehouse not found\"); });"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"warehouse_id\": \"KHO_KHONG_TON_TAI\",\n  \"supplier_id\": \"SUP1\",\n  \"products\": [\n    {\n      \"product_id\": \"SP001\",\n      \"quantity\": 100\n    }\n  ]\n}"
        },
        "url": "{{base_url}}/inventory/import"
      }
    },
    {
      "name": "TC3: Nhà cung cấp không tồn tại (Mô phỏng)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Assert response for missing/invalid supplier\", function () { pm.expect(pm.response.code).to.be.oneOf([201, 400, 500]); });"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"warehouse_id\": \"KHO_HN_01\",\n  \"supplier_id\": \"NCC_KHONG_TON_TAI\",\n  \"products\": [\n    {\n      \"product_id\": \"SP001\",\n      \"quantity\": 50\n    }\n  ]\n}"
        },
        "url": "{{base_url}}/inventory/import"
      }
    },
    {
      "name": "TC4: Sản phẩm không tồn tại",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 500 or 400 (Foreign key violation/validation)\", function () { pm.expect(pm.response.code).to.be.oneOf([400, 500]); });"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"warehouse_id\": \"KHO_HN_01\",\n  \"supplier_id\": \"SUP1\",\n  \"products\": [\n    {\n      \"product_id\": \"SP_FAKE\",\n      \"quantity\": 100\n    }\n  ]\n}"
        },
        "url": "{{base_url}}/inventory/import"
      }
    },
    {
      "name": "TC5 & TC9: Số lượng nhập không hợp lệ (<= 0)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 400\", function () { pm.response.to.have.status(400); });",
              "pm.test(\"Error matches invalid product data\", function () { pm.expect(pm.response.json().error).to.eql(\"Invalid product data in the products array\"); });"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"warehouse_id\": \"KHO_HN_01\",\n  \"supplier_id\": \"SUP1\",\n  \"products\": [\n    {\n      \"product_id\": \"SP001\",\n      \"quantity\": -50\n    }\n  ]\n}"
        },
        "url": "{{base_url}}/inventory/import"
      }
    },
    {
      "name": "TC6 & TC8: Tổng số lượng vượt quá sức chứa kho",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 400\", function () { pm.response.to.have.status(400); });",
              "pm.test(\"Error message includes capacity limit error\", function () { pm.expect(pm.response.json().error).to.include(\"Warehouse capacity exceeded\"); });"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"warehouse_id\": \"KHO_HN_01\",\n  \"supplier_id\": \"SUP1\",\n  \"products\": [\n    {\n      \"product_id\": \"SP001\",\n      \"quantity\": 150\n    }\n  ]\n}"
        },
        "url": "{{base_url}}/inventory/import"
      }
    },
    {
      "name": "Dọn dẹp sản phẩm đã test",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Deleted successfully\", function () { pm.expect(pm.response.code).to.be.oneOf([200, 404]); });"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "DELETE",
        "url": "{{base_url}}/products/SP001"
      }
    },
    {
      "name": "Dọn dẹp kho đã test",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Deleted successfully\", function () { pm.expect(pm.response.code).to.be.oneOf([200, 404]); });"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "DELETE",
        "url": "{{base_url}}/warehouses/KHO_HN_01"
      }
    }
  ]
}
