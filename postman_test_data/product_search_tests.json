{
  "info": {
    "name": "QL Kho - Test Tìm kiếm Sản Phẩm",
    "description": "Các trường hợp kiểm thử cho chức năng tìm kiếm sản phẩm theo tên (TC1 - TC5 của tìm kiếm sản phẩm)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:3000/api/v1"
    },
    {
      "key": "auth_token",
      "value": ""
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{auth_token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Đăng nhập lấy Token (Chuẩn bị)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "var jsonData = pm.response.json();",
              "if (jsonData.token) { pm.collectionVariables.set(\"auth_token\", jsonData.token); }"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "auth": { "type": "noauth" },
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"admin123\"\n}"
        },
        "url": "{{base_url}}/auth/login"
      }
    },
    {
      "name": "Tạo sản phẩm mẫu để test tìm kiếm",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 201\", function () { pm.response.to.have.status(201); });"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"customId\": \"SP_SEARCH_TEST\",\n  \"name\": \"Sản phẩm test tìm kiếm độc nhất\",\n  \"price\": 10000,\n  \"supplierId\": 1\n}"
        },
        "url": "{{base_url}}/products"
      }
    },
    {
      "name": "TC1: Tìm kiếm với từ khóa tồn tại",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () { pm.response.to.have.status(200); });",
              "pm.test(\"Có chứa sản phẩm vừa tạo\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.products.length).to.be.above(0);",
              "    var found = jsonData.products.some(p => p.custom_id === 'SP_SEARCH_TEST');",
              "    pm.expect(found).to.be.true;",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{base_url}}/products?search=độc nhất",
          "host": [ "{{base_url}}" ],
          "path": [ "products" ],
          "query": [ { "key": "search", "value": "độc nhất" } ]
        }
      }
    },
    {
      "name": "TC4: Tìm kiếm với từ khóa không tồn tại",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () { pm.response.to.have.status(200); });",
              "pm.test(\"Trả về danh sách rỗng\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.products.length).to.eql(0);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{base_url}}/products?search=XYZ123KhôngTồnTại_999",
          "host": [ "{{base_url}}" ],
          "path": [ "products" ],
          "query": [ { "key": "search", "value": "XYZ123KhôngTồnTại_999" } ]
        }
      }
    },
    {
      "name": "TC5: Tìm kiếm để trống từ khóa",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () { pm.response.to.have.status(200); });",
              "pm.test(\"Trả về danh sách sản phẩm\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.products.length).to.be.above(0);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{base_url}}/products?search=",
          "host": [ "{{base_url}}" ],
          "path": [ "products" ],
          "query": [ { "key": "search", "value": "" } ]
        }
      }
    },
    {
      "name": "TC2: Tìm kiếm không gửi Token",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 401\", function () { pm.response.to.have.status(401); });"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "auth": { "type": "noauth" },
        "method": "GET",
        "url": {
          "raw": "{{base_url}}/products?search=độc nhất",
          "host": [ "{{base_url}}" ],
          "path": [ "products" ],
          "query": [ { "key": "search", "value": "độc nhất" } ]
        }
      }
    },
    {
      "name": "TC3: Tìm kiếm Token sai/hết hạn",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 403\", function () { pm.response.to.have.status(403); });"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "auth": { "type": "noauth" },
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer fake_token_abc" }
        ],
        "url": {
          "raw": "{{base_url}}/products?search=độc nhất",
          "host": [ "{{base_url}}" ],
          "path": [ "products" ],
          "query": [ { "key": "search", "value": "độc nhất" } ]
        }
      }
    },
    {
      "name": "Dọn dẹp sản phẩm mẫu",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Deleted successfully\", function () { pm.expect(pm.response.code).to.be.oneOf([200, 404]); });"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "DELETE",
        "url": "{{base_url}}/products/SP_SEARCH_TEST"
      }
    }
  ]
}
