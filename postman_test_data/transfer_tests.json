{
  "info": {
    "name": "QL Kho - Test Chuyển Kho",
    "description": "Đầy đủ các trường hợp kiểm thử cho chức năng tạo phiếu chuyển kho giữa các kho bãi (TC1 - TC10)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:3000/api/v1"
    },
    {
      "key": "auth_token",
      "value": ""
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{auth_token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Đăng nhập lấy Token (Chuẩn bị)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "var jsonData = pm.response.json();",
              "if (jsonData.token) { pm.collectionVariables.set(\"auth_token\", jsonData.token); }"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "auth": {
          "type": "noauth"
        },
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"admin123\"\n}"
        },
        "url": "{{base_url}}/auth/login"
      }
    },
    {
      "name": "Chuẩn bị Kho bãi nguồn",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"custom_id\": \"KHO_HN_01\",\n  \"name\": \"Kho Hà Nội 1\",\n  \"capacity\": 1000\n}"
        },
        "url": "{{base_url}}/warehouses"
      }
    },
    {
      "name": "Chuẩn bị Kho bãi đích",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"custom_id\": \"KHO_SG_01\",\n  \"name\": \"Kho Sài Gòn 1\",\n  \"capacity\": 1000\n}"
        },
        "url": "{{base_url}}/warehouses"
      }
    },
    {
      "name": "Chuẩn bị Sản phẩm",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"customId\": \"SP001\",\n  \"name\": \"Sữa tươi TH True Milk\",\n  \"price\": 15000,\n  \"supplierId\": 1\n}"
        },
        "url": "{{base_url}}/products"
      }
    },
    {
      "name": "TC1 & TC7: Tạo phiếu chuyển kho thành công",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 201\", function () { pm.response.to.have.status(201); });",
              "pm.test(\"Contains success message\", function () { pm.expect(pm.response.json().message).to.eql(\"Transfer created successfully\"); });"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"from_warehouse_id\": \"KHO_HN_01\",\n  \"to_warehouse_id\": \"KHO_SG_01\",\n  \"items\": [\n    {\n      \"product_id\": \"SP001\",\n      \"quantity\": 50\n    }\n  ],\n  \"notes\": \"Chuyển hàng kiểm thử\"\n}"
        },
        "url": "{{base_url}}/transfers"
      }
    },
    {
      "name": "TC2 & TC8: Kho nguồn và kho đích giống nhau",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 400\", function () { pm.response.to.have.status(400); });",
              "pm.test(\"Error matches duplicate warehouse check\", function () { pm.expect(pm.response.json().error).to.eql(\"From and to warehouses cannot be the same\"); });"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"from_warehouse_id\": \"KHO_HN_01\",\n  \"to_warehouse_id\": \"KHO_HN_01\",\n  \"items\": [\n    {\n      \"product_id\": \"SP001\",\n      \"quantity\": 50\n    }\n  ]\n}"
        },
        "url": "{{base_url}}/transfers"
      }
    },
    {
      "name": "TC3: Kho nguồn không tồn tại",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Assert warehouse existence check\", function () { pm.expect(pm.response.code).to.be.oneOf([400, 500]); });"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"from_warehouse_id\": \"KHO_KHONG_TON_TAI\",\n  \"to_warehouse_id\": \"KHO_SG_01\",\n  \"items\": [\n    {\n      \"product_id\": \"SP001\",\n      \"quantity\": 50\n    }\n  ]\n}"
        },
        "url": "{{base_url}}/transfers"
      }
    },
    {
      "name": "TC4: Danh sách sản phẩm bị trống",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 400\", function () { pm.response.to.have.status(400); });",
              "pm.test(\"Error matches missing items\", function () { pm.expect(pm.response.json().error).to.eql(\"Missing required fields or empty items list\"); });"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"from_warehouse_id\": \"KHO_HN_01\",\n  \"to_warehouse_id\": \"KHO_SG_01\",\n  \"items\": []\n}"
        },
        "url": "{{base_url}}/transfers"
      }
    },
    {
      "name": "TC5 & TC9: Số lượng chuyển không hợp lệ (<= 0)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Assert quantity range validation\", function () { pm.expect(pm.response.code).to.be.oneOf([400, 500]); });"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"from_warehouse_id\": \"KHO_HN_01\",\n  \"to_warehouse_id\": \"KHO_SG_01\",\n  \"items\": [\n    {\n      \"product_id\": \"SP001\",\n      \"quantity\": -10\n    }\n  ]\n}"
        },
        "url": "{{base_url}}/transfers"
      }
    },
    {
      "name": "Dọn dẹp Sản phẩm đã tạo",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Deleted successfully\", function () { pm.expect(pm.response.code).to.be.oneOf([200, 404]); });"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "DELETE",
        "url": "{{base_url}}/products/SP001"
      }
    },
    {
      "name": "Dọn dẹp Kho nguồn đã tạo",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Deleted successfully\", function () { pm.expect(pm.response.code).to.be.oneOf([200, 404]); });"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "DELETE",
        "url": "{{base_url}}/warehouses/KHO_HN_01"
      }
    },
    {
      "name": "Dọn dẹp Kho đích đã tạo",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Deleted successfully\", function () { pm.expect(pm.response.code).to.be.oneOf([200, 404]); });"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "DELETE",
        "url": "{{base_url}}/warehouses/KHO_SG_01"
      }
    }
  ]
}
