{
  "info": {
    "name": "QL Kho - Test Đăng Xuất",
    "description": "Đầy đủ các trường hợp kiểm thử cho chức năng đăng xuất (TC1 - TC7)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:3000/api/v1"
    },
    {
      "key": "auth_token",
      "value": ""
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{auth_token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "TC1 & TC5: Đăng xuất thành công",
      "request": {
        "method": "POST",
        "url": "{{base_url}}/auth/logout"
      }
    },
    {
      "name": "TC2: Đăng xuất khi phiên đã hết hạn/không hợp lệ",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer expired_token"
          }
        ],
        "url": "{{base_url}}/auth/logout"
      }
    },
    {
      "name": "TC3 & TC4: Truy cập sau khi đã đăng xuất (Mô phỏng)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{auth_token}}"
          }
        ],
        "url": "{{base_url}}/users/count",
        "description": "Thử truy cập dữ liệu sau khi đã gọi logout để kiểm tra token còn hiệu lực không."
      }
    },
    {
      "name": "TC6: Tiếp tục thao tác khi không bấm đăng xuất",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/dashboard/stats"
      }
    },
    {
      "name": "TC7: Đăng xuất trên nhiều tab",
      "request": {
        "method": "POST",
        "url": "{{base_url}}/auth/logout",
        "description": "Gửi yêu cầu đăng xuất lần 2 khi session đã bị hủy ở lần 1."
      }
    }
  ]
}