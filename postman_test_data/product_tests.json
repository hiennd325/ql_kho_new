{
  "info": {
    "name": "QL Kho - Test Sản Phẩm",
    "description": "Đầy đủ các trường hợp kiểm thử cho chức năng thêm sản phẩm và xem chi tiết sản phẩm (TC1 - TC10 của thêm sản phẩm và TC1 - TC4 của xem chi tiết)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:3000/api/v1"
    },
    {
      "key": "auth_token",
      "value": ""
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{auth_token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Đăng nhập lấy Token (Chuẩn bị)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "var jsonData = pm.response.json();",
              "if (jsonData.token) { pm.collectionVariables.set(\"auth_token\", jsonData.token); }"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "auth": {
          "type": "noauth"
        },
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"admin123\"\n}"
        },
        "url": "{{base_url}}/auth/login"
      }
    },
    {
      "name": "TC1: Thêm sản phẩm thành công",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 201\", function () { pm.response.to.have.status(201); });",
              "pm.test(\"Contains product ID\", function () { pm.expect(pm.response.json().id).to.eql(\"SP_TH_001\"); });"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"customId\": \"SP_TH_001\",\n  \"name\": \"Sữa tươi TH True Milk\",\n  \"price\": 15000,\n  \"supplierId\": 1,\n  \"category\": \"Thực phẩm\",\n  \"brand\": \"TH\"\n}"
        },
        "url": "{{base_url}}/products"
      }
    },
    {
      "name": "TC2 & TC10: Tên sản phẩm không được để trống",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 500 (DB Constraint)\", function () { pm.response.to.have.status(500); });",
              "pm.test(\"Contains error message\", function () { pm.expect(pm.response.json().error).to.include(\"NOT NULL constraint failed\"); });"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"customId\": \"SP_TH_002\",\n  \"name\": \"\",\n  \"price\": 15000,\n  \"supplierId\": 1\n}"
        },
        "url": "{{base_url}}/products"
      }
    },
    {
      "name": "TC3 & TC9: Giá sản phẩm nhỏ hơn 0 (Lỗi validation)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Assert response for negative price\", function () { pm.expect(pm.response.code).to.be.oneOf([201, 400]); });"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"customId\": \"SP_TH_003\",\n  \"name\": \"Sữa tươi TH True Milk\",\n  \"price\": -5000,\n  \"supplierId\": 1\n}"
        },
        "url": "{{base_url}}/products"
      }
    },
    {
      "name": "TC4: Giá sản phẩm không phải là số hợp lệ",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Assert response status\", function () { pm.expect(pm.response.code).to.be.oneOf([400, 500]); });"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"customId\": \"SP_TH_004\",\n  \"name\": \"Sữa tươi TH True Milk\",\n  \"price\": \"abc\",\n  \"supplierId\": 1\n}"
        },
        "url": "{{base_url}}/products"
      }
    },
    {
      "name": "TC5 & TC8: Mã sản phẩm đã tồn tại",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 400\", function () { pm.response.to.have.status(400); });",
              "pm.test(\"Contains error duplicate customId\", function () { pm.expect(pm.response.json().error).to.eql(\"Mã sản phẩm đã tồn tại\"); });"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"customId\": \"SP_TH_001\",\n  \"name\": \"Sữa tươi TH True Milk\",\n  \"price\": 15000,\n  \"supplierId\": 1\n}"
        },
        "url": "{{base_url}}/products"
      }
    },
    {
      "name": "TC7: Thêm sản phẩm thành công (Bánh mì)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 201\", function () { pm.response.to.have.status(201); });"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"customId\": \"SP_BM_001\",\n  \"name\": \"Bánh mì\",\n  \"price\": 10000,\n  \"supplierId\": 1\n}"
        },
        "url": "{{base_url}}/products"
      }
    },
    {
      "name": "Chi tiết SP TC1: Xem chi tiết sản phẩm thành công",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () { pm.response.to.have.status(200); });",
              "pm.test(\"Response contains product detail fields\", function () { \n  var jsonData = pm.response.json();\n  pm.expect(jsonData).to.have.property(\"custom_id\");\n  pm.expect(jsonData.name).to.eql(\"Sữa tươi TH True Milk\");\n});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": "{{base_url}}/products/SP_TH_001"
      }
    },
    {
      "name": "Chi tiết SP TC2: Xem chi tiết sản phẩm không gửi Token",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 401\", function () { pm.response.to.have.status(401); });",
              "pm.test(\"Error matches access token required\", function () { pm.expect(pm.response.json().error).to.eql(\"Access token required\"); });"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "auth": {
          "type": "noauth"
        },
        "method": "GET",
        "url": "{{base_url}}/products/SP_TH_001"
      }
    },
    {
      "name": "Chi tiết SP TC3: Xem chi tiết sản phẩm Token sai/hết hạn",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 403\", function () { pm.response.to.have.status(403); });",
              "pm.test(\"Error matches invalid token\", function () { pm.expect(pm.response.json().error).to.eql(\"Invalid token\"); });"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "auth": {
          "type": "noauth"
        },
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer fake_or_expired_token"
          }
        ],
        "url": "{{base_url}}/products/SP_TH_001"
      }
    },
    {
      "name": "Chi tiết SP TC4: Xem chi tiết sản phẩm Mã sản phẩm không tồn tại",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 404\", function () { pm.response.to.have.status(404); });",
              "pm.test(\"Error matches product not found\", function () { pm.expect(pm.response.json().error).to.eql(\"Product not found\"); });"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": "{{base_url}}/products/SP_KHONG_TON_TAI"
      }
    },
    {
      "name": "Dọn dẹp sản phẩm đã tạo",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Deleted successfully\", function () { pm.expect(pm.response.code).to.be.oneOf([200, 404]); });"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "DELETE",
        "url": "{{base_url}}/products/SP_TH_001"
      }
    },
    {
      "name": "Dọn dẹp sản phẩm bánh mì đã tạo",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Deleted successfully\", function () { pm.expect(pm.response.code).to.be.oneOf([200, 404]); });"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "DELETE",
        "url": "{{base_url}}/products/SP_BM_001"
      }
    }
  ]
}
