{
  "info": {
    "name": "QL Kho - Test Nhà Cung Cấp",
    "description": "Đầy đủ các trường hợp kiểm thử cho chức năng thêm nhà cung cấp mới (TC1 - TC10)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:3000/api/v1"
    },
    {
      "key": "auth_token",
      "value": ""
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{auth_token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Đăng nhập lấy Token (Chuẩn bị)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "var jsonData = pm.response.json();",
              "if (jsonData.token) { pm.collectionVariables.set(\"auth_token\", jsonData.token); }"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "auth": {
          "type": "noauth"
        },
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"admin123\"\n}"
        },
        "url": "{{base_url}}/auth/login"
      }
    },
    {
      "name": "TC1: Thêm nhà cung cấp thành công",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 201\", function () { pm.response.to.have.status(201); });",
              "pm.test(\"Contains supplier code\", function () { pm.expect(pm.response.json().code).to.eql(\"NCC001\"); });"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"code\": \"NCC001\",\n  \"name\": \"Công ty TH True Milk\",\n  \"phone\": \"0987654321\",\n  \"email\": \"info@thmilk.com\",\n  \"address\": \"Nghệ An\"\n}"
        },
        "url": "{{base_url}}/suppliers"
      }
    },
    {
      "name": "TC2 & TC10: Mã nhà cung cấp đã tồn tại",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 400\", function () { pm.response.to.have.status(400); });",
              "pm.test(\"Contains duplicate error\", function () { pm.expect(pm.response.json().error).to.eql(\"Mã nhà cung cấp đã tồn tại\"); });"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"code\": \"NCC001\",\n  \"name\": \"Công ty sữa TH\",\n  \"phone\": \"0987654321\",\n  \"email\": \"info@thmilk.com\"\n}"
        },
        "url": "{{base_url}}/suppliers"
      }
    },
    {
      "name": "TC3: Mã nhà cung cấp bị trống",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 400\", function () { pm.response.to.have.status(400); });",
              "pm.test(\"Error matches missing code\", function () { pm.expect(pm.response.json().error).to.eql(\"Mã nhà cung cấp là bắt buộc\"); });"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"code\": \"\",\n  \"name\": \"Công ty sữa TH\"\n}"
        },
        "url": "{{base_url}}/suppliers"
      }
    },
    {
      "name": "TC4: Tên nhà cung cấp bị trống",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 500 (DB Constraint)\", function () { pm.response.to.have.status(500); });",
              "pm.test(\"Contains database constraint error\", function () { pm.expect(pm.response.json().error).to.include(\"NOT NULL constraint failed\"); });"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"code\": \"NCC002\",\n  \"name\": \"\"\n}"
        },
        "url": "{{base_url}}/suppliers"
      }
    },
    {
      "name": "TC5 & TC8: Số điện thoại không hợp lệ (Khác 10 số)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 400\", function () { pm.response.to.have.status(400); });",
              "pm.test(\"Error matches phone validation\", function () { pm.expect(pm.response.json().error).to.eql(\"Số điện thoại phải là 10 chữ số.\"); });"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"code\": \"NCC002\",\n  \"name\": \"Công ty sữa TH\",\n  \"phone\": \"12345\",\n  \"email\": \"info@thmilk.com\"\n}"
        },
        "url": "{{base_url}}/suppliers"
      }
    },
    {
      "name": "TC6 & TC9: Email sai định dạng",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 400\", function () { pm.response.to.have.status(400); });",
              "pm.test(\"Error matches email validation\", function () { pm.expect(pm.response.json().error).to.eql(\"Email phải có định dạng example@company.com\"); });"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"code\": \"NCC002\",\n  \"name\": \"Công ty sữa TH\",\n  \"phone\": \"0987654321\",\n  \"email\": \"info@thmilk\"\n}"
        },
        "url": "{{base_url}}/suppliers"
      }
    },
    {
      "name": "TC7: Thêm nhà cung cấp thành công (NCC003)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 201\", function () { pm.response.to.have.status(201); });"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"code\": \"NCC003\",\n  \"name\": \"Nhà cung cấp 3\",\n  \"phone\": \"0123456789\",\n  \"email\": \"contact@ncc.com\"\n}"
        },
        "url": "{{base_url}}/suppliers"
      }
    },
    {
      "name": "Dọn dẹp nhà cung cấp NCC001",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Deleted successfully\", function () { pm.expect(pm.response.code).to.be.oneOf([200, 404, 500]); });"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "DELETE",
        "url": "{{base_url}}/suppliers/NCC001"
      }
    },
    {
      "name": "Dọn dẹp nhà cung cấp NCC003",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Deleted successfully\", function () { pm.expect(pm.response.code).to.be.oneOf([200, 404, 500]); });"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "DELETE",
        "url": "{{base_url}}/suppliers/NCC003"
      }
    }
  ]
}
