{
  "info": {
    "name": "QL Kho - Test Đăng Ký",
    "description": "Đầy đủ các trường hợp kiểm thử cho chức năng đăng ký (TC1 - TC13)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:3000/api/v1"
    }
  ],
  "item": [
    {
      "name": "TC1 & TC10: Đăng ký thành công (Hợp lệ)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"AdminHung_New\",\n  \"password\": \"Admin12345\",\n  \"confirmPassword\": \"Admin12345\"\n}"
        },
        "url": "{{base_url}}/auth/register"
      }
    },
    {
      "name": "TC2: Tên đăng nhập rỗng",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
