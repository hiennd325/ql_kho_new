        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"\",\n  \"password\": \"Admin12345\",\n  \"confirmPassword\": \"Admin12345\"\n}"
        },
        "url": "{{base_url}}/auth/register"
      }
    },
